---
layout: base.njk
title: "Event Rules | QTs & Cuties"
bodyClass: page-rules
scripts: false
---

<section class="intro">
    <h1>QTs &amp; Cuties: Event Rules</h1>
    <p>{{ rules.intro }}</p>
</section>

<section class="events-section">
    <h2>{{ rules.heading }}</h2>

    {%- for section in rules.sections %}
    <div class="event-card{% if not loop.first %} stacked-card{% endif %}">
        <div class="event-title">{{ section.title }}</div>
        <div class="event-details">
            {%- for item in section.items %}
            <div class="event-detail-item">
                {#- Items are repo-controlled content; the Accountability item
                    contains a literal mailto anchor, hence | safe. -#}
                <span>{{ item | safe }}</span>
            </div>
            {%- endfor %}
        </div>
    </div>
    {%- endfor %}
</section>
