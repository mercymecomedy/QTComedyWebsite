<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css?v={{ buildTime }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💜</text></svg>">
</head>
<body>
    <header>
        <div class="container">
            <h1>{{ headerTitle | default(title) }}</h1>
            <nav>
                {% if showHomeNav %}
                <a href="/" class="nav-link">Home</a>
                {% else %}
                <a href="/rules/" class="nav-link">Rules</a>
                {% endif %}
                <a href="mailto:{{ site.email }}" class="nav-link">Contact</a>
                <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" class="nav-link">Instagram</a>
            </nav>
        </div>
    </header>

    <main>
        <div class="container">
            {{ content | safe }}
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Connect With Us</h3>
                </div>
                <div class="footer-section">
                    <div class="social-links">
                        <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" class="social-link">
                            Instagram
                        </a>
                        <a href="mailto:{{ site.email }}" class="social-link">
                            Email Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    {% if includeScripts != false %}
    <script src="/script.js?v={{ buildTime }}"></script>
    {% endif %}
</body>
</html>
