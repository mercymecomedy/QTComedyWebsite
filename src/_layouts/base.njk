<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.shortTitle }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <link rel="stylesheet" href="/assets/main.css?v={{ buildTime }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💜</text></svg>">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <div class="container site-header-inner">
            <a href="/" class="site-title">{{ site.shortTitle }}</a>
            <nav aria-label="Main navigation">
                <ul class="site-nav">
                    {% for item in site.navigation %}
                    <li>
                        <a href="{{ item.url }}" class="nav-link"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
            <div class="header-social">
                <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" class="nav-link">Instagram</a>
            </div>
        </div>
    </header>

    <main id="main-content">
        <div class="container">
            {{ content | safe }}
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h2 class="footer-heading">Connect With Us</h2>
                </div>
                <div class="footer-section">
                    <ul class="social-links">
                        <li>
                            <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" class="social-link">
                                Instagram
                            </a>
                        </li>
                        <li>
                            <a href="mailto:{{ site.email }}" class="social-link">
                                Email Us
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    {% if scripts != false %}
    <script src="/assets/main.js?v={{ buildTime }}"></script>
    {% endif %}
</body>
</html>
